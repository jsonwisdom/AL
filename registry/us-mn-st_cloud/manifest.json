{
  "target_id": "ST_CLOUD_001",
  "scope": "municipal_governance",
  "jurisdiction": "us-mn-st_cloud",
  "document_class": "city_council_minutes",
  "schema_version": "1.1.0",
  "extraction_profile": {
    "engine": "html_table_pdf_extractor",
    "origin_uri": "https://ci.stcloud.mn.us/Archive.aspx?AMID=43",
    "selectors": {
      "container": "#archiveCenterEntries",
      "row_link": "a[href*='DownloadFile.ashx']",
      "date_regex": "\\b(?:January|February|March|April|May|June|July|August|September|October|November|December)\\s+\\d{1,2},\\s+2026\\b"
    },
    "normalization_rules": [
      "strip_ephemeral_session_tokens",
      "convert_tables_to_markdown_pipes",
      "collate_whitespace_blocks",
      "remove_page_numbers_and_running_footers"
    ],
    "drift_keywords": [
      "setback",
      "variance",
      "zoning",
      "buffer",
      "zoning_overlay"
    ]
  },
  "polling_policy": {
    "frequency_hours": 24,
    "timeout_seconds": 30,
    "retry_limit": 3
  },
  "state_control": {
    "initial_state": "VERIFIED",
    "require_receipt_on_drift": true
  }
}
