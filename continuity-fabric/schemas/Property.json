{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Property.json",
  "title": "AssetRegistry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "ERC20",
        "ERC721",
        "NATIVE",
        "ERC1155"
      ]
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "LOW",
        "HIGH",
        "UNMODELED"
      ]
    },
    "contract_address": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "description": "Validated 20-byte hex address."
    },
    "chain_id": {
      "type": "integer",
      "minimum": 1
    },
    "decimals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18
    }
  },
  "required": [
    "type",
    "risk_class",
    "contract_address",
    "chain_id",
    "decimals"
  ]
}
