{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jsonwisdom/AL/lineage/asset_lineage_schema_v1.json",
  "title": "ASSET_LINEAGE_EVENT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "event_index",
    "prev_file_hash",
    "asset_id",
    "asset_hash",
    "hash_algorithm",
    "branch_id",
    "manifest_hash",
    "cbre_trace_hash",
    "timestamp_utc",
    "signature"
  ],
  "properties": {
    "event_type": {
      "const": "ASSET_BINDING"
    },
    "event_index": {
      "type": "integer",
      "minimum": 0
    },
    "prev_file_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "asset_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hash_algorithm": {
      "const": "SHA-256"
    },
    "branch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cbre_trace_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  }
}
