{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.github.io/AL/agents/track020/schemas/track020_mainnet_attestation_candidate_v1.schema.json",
  "title": "TRACK_020_MAINNET_ATTESTATION_CANDIDATE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "version",
    "track",
    "chain_profile",
    "eas_schema_ref",
    "runtime_dependency",
    "onchain_state",
    "attestation_payload",
    "operator_signature_required",
    "no_ghost_anchor"
  ],
  "properties": {
    "artifact": { "const": "TRACK_020_MAINNET_ATTESTATION_CANDIDATE" },
    "version": { "const": "1.0" },
    "track": { "const": "TRACK_020" },
    "chain_profile": { "const": "base-mainnet" },
    "eas_schema_ref": { "const": "AGW_FederatedRecovery_v1" },
