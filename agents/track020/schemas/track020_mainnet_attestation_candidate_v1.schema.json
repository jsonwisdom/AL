        "epochId": { "const": "PENDING" },
        "courtId": { "type": "string" },
        "regenerationManifestHash": { "const": "PENDING_TRACK_019_TESTNET_PROOF" },
        "recoveryReceiptHash": { "const": "PENDING_TRACK_019_TESTNET_PROOF" },
        "federationReadinessHash": { "const": "PENDING_TRACK_019_TESTNET_PROOF" },
        "state": { "const": "BLOCKED_PENDING_TRACK_019_RUNTIME_PROOF" }
      }
