{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/jsonwisdom/AL/blob/master/agents/base_mcp/schemas/session_log.schema.json",
  "title": "Base MCP Session Log",
  "description": "Tracks a continuous sequence of action receipts within a bounded session. Enables replay, audit, and session termination.",
  "type": "object",
  "required": [
    "session_id",
    "started_at",
    "agent_identity",
    "receipt_chain",
    "session_status"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Unique session identifier."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when session began."
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when session ended."
    },
    "agent_identity": {
      "type": "string",
      "description": "Identity of the agent running this session."
    },
    "session_context": {
      "type": "object",
      "description": "Optional session context.",
      "additionalProperties": true
    },
    "receipt_chain": {
      "type": "array",
      "description": "Ordered sequence of action receipt IDs in this session.",
      "items": {
        "type": "string"
      }
    },
    "session_status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "terminated",
        "expired",
        "revoked"
      ],
      "description": "Current session state.",
      "default": "active"
    },
    "termination_reason": {
      "type": "string",
      "description": "Why the session ended or was revoked.",
      "enum": [
        "user_initiated",
        "timeout",
        "policy_violation",
        "error",
        "system_shutdown",
        "authority_revoked"
      ]
    },
    "policy_bundle_id": {
      "type": "string",
      "description": "Specific policy bundle governing this session."
    },
    "authority_limits_used": {
      "type": "object",
      "description": "Accumulated authority consumption within this session.",
      "properties": {
        "total_spend_usd": {
          "type": "number",
          "minimum": 0
        },
        "action_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "description": "Optional replay checkpoint.",
      "properties": {
        "last_receipt_id": {
          "type": "string"
        },
        "state_hash": {
          "type": "string"
        },
        "checkpointed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
