{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ObserverReport",
  "description": "Signed report from a constitutional Observer",
  "type": "object",
  "properties": {
    "observer": {
      "$ref": "observer.schema.json"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observed_state_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "required": [
    "observer",
    "event_id",
    "observed_state_root",
    "signature"
  ],
  "additionalProperties": false
}
