{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "type": "object",
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parent": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "payload": true,
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observer_id": { "type": "string" },
          "signature": { "type": "string" }
        },
        "required": ["observer_id", "signature"],
        "additionalProperties": false
      }
    },
    "timestamp": { "type": "integer", "minimum": 0 }
  },
  "required": ["id", "parent", "payload", "signatures", "timestamp"],
  "additionalProperties": false
}
