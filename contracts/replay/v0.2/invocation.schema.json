{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.org/contracts/replay/v0.2/invocation.schema.json",
  "title": "Replay Invocation Schema v0.2",
  "description": "Multi-command replay invocation. v0.2 adds replay_command and replay_args while preserving deterministic invocation_id hashing over canonical JSON without invocation_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invocation_id",
    "schema_version",
    "envelope_ref",
    "envelope_sha256",
    "entrypoint",
    "witness",
    "canonicalization",
    "options",
    "expected_outputs",
    "replay_command"
  ],
  "properties": {
    "invocation_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256 of canonical JSON with invocation_id omitted. replay_command and replay_args are included in canonical bytes."
    },
    "schema_version": {
      "const": "invocation-v0.2"
    },
    "envelope_ref": {
      "type": "string",
      "pattern": "^contracts/replay/v0\\.[12]/[A-Za-z0-9_./-]+\\.json$"
    },
    "envelope_sha256": {
      "$ref": "#/$defs/sha256_uri"
    },
    "entrypoint": {
      "const": "./verify.sh --invocation"
    },
    "replay_command": {
      "type": "string",
      "enum": ["echo_golden", "check_policy"]
    },
    "replay_args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "strict_mode"],
      "properties": {
        "target": {
          "enum": [
            "PYTHON_3.8",
            "PYTHON_3.9",
            "PYTHON_3.10",
            "PYTHON_3.11",
            "PYTHON_3.12",
            "PYTHON_3.13",
            "DOCKER_3.12_SLIM"
          ]
        },
        "strict_mode": {
          "const": true
        }
      }
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unicode", "encoding", "json", "key_order", "whitespace", "case"],
      "properties": {
        "unicode": { "const": "NFC" },
        "encoding": { "const": "UTF-8" },
        "json": { "const": "JCS" },
        "key_order": { "const": "lexicographic" },
        "whitespace": { "const": "compact" },
        "case": { "const": "preserve" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_convergence", "timeout_seconds", "network"],
      "properties": {
        "require_convergence": { "const": true },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "network": { "const": "disabled" }
      }
    },
    "expected_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stdout_sha256", "canonicalization"],
      "properties": {
        "stdout_sha256": { "$ref": "#/$defs/sha256_uri" },
        "canonicalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strip_single_trailing_newline", "unicode", "invalid_utf8"],
          "properties": {
            "strip_single_trailing_newline": { "const": true },
            "unicode": { "const": "NFC_IF_VALID_UTF8" },
            "invalid_utf8": { "const": "HASH_RAW_BYTES" }
          }
        }
      }
    }
  },
  "not": {
    "anyOf": [
      { "required": ["seed"] },
      { "required": ["nonce"] },
      { "required": ["timestamp_generated"] },
      { "required": ["debug"] },
      { "required": ["cache"] },
      { "required": ["env"] },
      { "required": ["uuid"] },
      { "required": ["random"] },
      { "required": ["created_at"] },
      { "required": ["updated_at"] }
    ]
  },
  "$defs": {
    "sha256_uri": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
