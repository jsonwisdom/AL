{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.org/contracts/keys/v0.1/registry.schema.json",
  "title": "ALMS Key Registry v0.1",
  "description": "Public key registry for replay envelope signature verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "keys"],
  "properties": {
    "registry_version": { "const": "key-registry-v0.1" },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "active", "public_key_pem"],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^KEY_[A-Za-z0-9_.:-]+$"
          },
          "algorithm": { "const": "ECDSA_P256_SHA256_DER_V1" },
          "active": { "type": "boolean" },
          "public_key_pem": {
            "type": "string",
            "pattern": "^-----BEGIN PUBLIC KEY-----[\\s\\S]+-----END PUBLIC KEY-----\\n?$"
          }
        }
      }
    }
  }
}
