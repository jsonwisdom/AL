{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALMS_ADVERSARIAL_REPORT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "attack_surface",
    "assumptions",
    "steps",
    "effect",
    "invariant_impacted",
    "proposed_patch",
    "classification"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "attack_surface": {
      "type": "string",
      "enum": [
        "schema_level_ambiguity",
        "encoding_edge_case",
        "cidv0_edge_behavior",
        "entry_reordering",
        "merkle_tree_edge_case",
        "proof_replay_ambiguity",
        "commit_message_semantics",
        "unstated_assumption"
      ]
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "effect": { "type": "string", "minLength": 1 },
    "invariant_impacted": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "entry_order",
          "cid_commit_consistency",
          "leaf_rule",
          "pair_hash_rule",
          "sibling_order",
          "position_meaning",
          "cid_version",
          "additionalProperties",
          "override",
          "schema_contract"
        ]
      }
    },
    "proposed_patch": { "type": "string", "minLength": 1 },
    "classification": {
      "type": "string",
      "enum": ["VALID_FINDING", "INVALID_FINDING", "NEEDS_REPRODUCTION"]
    }
  }
}
