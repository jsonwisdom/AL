{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alms.jaywisdom.xyz/schema/receipt-v2.json",
  "title": "ALMS Receipt V2",
  "description": "Canonical, tamper-evident, replayable receipt for Machine Speed ALMS V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "schema_version", "input_hash", "normalized_hash", "transform_version", "invariant_version", "verdict", "valid_as_of", "replay_cmd"],
  "properties": {
    "receipt_id": { "type": "string", "pattern": "^ALMS-MS-\\d{3,}$" },
    "schema_version": { "type": "string", "const": "2.0" },
    "input_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "normalized_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "receipt_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "transform_version": { "type": "string", "enum": ["normalize_strict_v1"] },
    "invariant_version": { "type": "string", "enum": ["invariants_v1"] },
    "original_claim": { "type": "string", "minLength": 1 },
    "normalized_text": { "type": "string", "minLength": 1 },
    "numeric_extract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor_version", "numbers_hash", "numbers", "numbers_fingerprint"],
      "properties": {
        "extractor_version": { "type": "string", "const": "alms_numeric_extractor_v1" },
        "numbers_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "numbers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "raw", "canonical_number", "scale", "unit", "base_value", "start", "end"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "raw": { "type": "string" },
              "canonical_number": { "type": "string" },
              "scale": { "type": "string" },
              "unit": { "type": "string", "enum": ["number", "percent", "usd"] },
              "base_value": { "type": "string" },
              "source_anchor": { "type": ["string", "null"] },
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "numbers_fingerprint": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "unit", "base_value", "scale"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "unit": { "type": "string", "enum": ["number", "percent", "usd"] },
              "base_value": { "type": "string" },
              "scale": { "type": "string" }
            }
          }
        }
      }
    },
    "source_match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker_version", "passed", "results"],
      "properties": {
        "checker_version": { "type": "string", "const": "alms_source_match_v1" },
        "passed": { "type": "boolean" },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "raw", "unit", "base_value", "scale", "source_anchor", "matched"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "raw": { "type": "string" },
              "unit": { "type": "string", "enum": ["number", "percent", "usd"] },
              "base_value": { "type": "string" },
              "scale": { "type": "string" },
              "source_anchor": { "type": ["string", "null"] },
              "matched": { "type": "boolean" }
            }
          }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["VERIFIED", "FALSE", "MISLEADING", "UNVERIFIED", "NEEDS_MORE_EVIDENCE"] },
    "verdict_reason": { "type": "string" },
    "failure_states": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["SOURCE_TIMEOUT", "FORMAT_DRIFT", "INVARIANT_CONFLICT", "AMBIGUOUS_ENTITY", "NON_REPRODUCIBLE"] } },
    "invariants_results": { "type": "array", "items": { "type": "object", "required": ["id", "passed"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "passed": { "type": "boolean" }, "details": { "type": "string" } } } },
    "proofs": { "type": "array", "items": { "type": "object", "required": ["source_url", "fetch_timestamp", "content_hash"], "additionalProperties": false, "properties": { "source_url": { "type": "string", "format": "uri" }, "archived_cid": { "type": "string" }, "fetch_timestamp": { "type": "string", "format": "date-time" }, "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "status": { "type": "string", "enum": ["LIVE", "ARCHIVED", "TIMEOUT"] } } } },
    "valid_as_of": { "type": "string", "format": "date-time" },
    "replay_cmd": { "type": "string" },
    "environment": { "type": "object", "additionalProperties": false, "properties": { "verifier_version": { "type": "string" }, "git_commit": { "type": "string" } } }
  }
}
