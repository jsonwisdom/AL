{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALMS_MERKLE_ROOT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "root_type",
    "entry_count",
    "leaf_hashes",
    "merkle_root",
    "construction",
    "ordering",
    "classification"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ALMS_MERKLE_ROOT_V1"
    },
    "version": {
      "type": "string",
      "const": "v1"
    },
    "root_type": {
      "type": "string",
      "enum": ["LEDGER_ROOT"]
    },
    "entry_count": {
      "type": "integer",
      "minimum": 1
    },
    "leaf_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "merkle_root": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf_hash_rule", "pair_hash_rule", "odd_leaf_rule"],
      "properties": {
        "leaf_hash_rule": {
          "type": "string",
          "const": "sha256(canonical_entry_json_bytes)"
        },
        "pair_hash_rule": {
          "type": "string",
          "const": "sha256(left_hex + right_hex)"
        },
        "odd_leaf_rule": {
          "type": "string",
          "const": "promote_last_leaf"
        }
      }
    },
    "ordering": {
      "type": "string",
      "const": "ascending_entry_number"
    },
    "classification": {
      "type": "string",
      "enum": ["VALID", "UNVERIFIED", "INVALID"]
    }
  }
}
