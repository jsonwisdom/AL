{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALMS_LEDGER_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "entries", "merkle_root"],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "ALMS-LEDGER v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "title": "ALMS_LEDGER_ENTRY_V1",
        "additionalProperties": false,
        "required": ["entry_id", "cid_binding", "commit"],
        "properties": {
          "entry_id": { "type": "string" },
          "cid_binding": {
            "type": "object",
            "title": "ALMS_CID_BINDING_V1",
            "additionalProperties": false,
            "required": ["artifact", "sha256", "cid", "binding", "verification"],
            "properties": {
              "artifact": { "type": "string" },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "cid": {
                "type": "string",
                "pattern": "^Qm[1-9A-HJ-NP-Za-km-z]{44}$",
                "description": "CIDv0 only for ALMS_LEDGER_V1."
              },
              "binding": {
                "type": "string",
                "enum": ["STRICT"]
              },
              "verification": {
                "type": "string",
                "enum": ["DUAL_MATCH_REQUIRED"]
              }
            }
          },
          "commit": {
            "type": "object",
            "title": "ALMS_AUTO_COMMIT_PROTOCOL_V1",
            "additionalProperties": false,
            "required": ["entry", "sha256", "cid", "ipfs_status", "timestamp", "message", "mode"],
            "properties": {
              "entry": { "type": "string" },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "cid": {
                "type": "string",
                "pattern": "^Qm[1-9A-HJ-NP-Za-km-z]{44}$"
              },
              "ipfs_status": {
                "type": "string",
                "enum": ["PINNED", "FAILED", "UNKNOWN"]
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              },
              "message": { "type": "string" },
              "mode": {
                "type": "string",
                "enum": ["SPEC_ONLY"]
              }
            }
          },
          "proof": {
            "type": "object",
            "title": "ALMS_MERKLE_PROOF_V1",
            "additionalProperties": false,
            "required": ["protocol", "entry_id", "leaf", "merkle_root", "siblings"],
            "properties": {
              "protocol": {
                "type": "string",
                "const": "ALMS_MERKLE_PROOF_V1"
              },
              "entry_id": { "type": "string" },
              "leaf": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "merkle_root": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "siblings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["position", "hash"],
                  "properties": {
                    "position": {
                      "type": "string",
                      "enum": ["LEFT", "RIGHT"],
                      "description": "sibling_position_relative_to_current; ordered bottom_to_top"
                    },
                    "hash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "merkle_root": {
      "type": "object",
      "title": "ALMS_MERKLE_ROOT_V1",
      "additionalProperties": false,
      "required": ["protocol", "value", "entries", "ordering", "mode"],
      "properties": {
        "protocol": {
          "type": "string",
          "const": "ALMS_MERKLE_ROOT_V1"
        },
        "value": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "type": "integer",
          "minimum": 1
        },
        "ordering": {
          "type": "string",
          "const": "lexicographic"
        },
        "mode": {
          "type": "string",
          "enum": ["SPEC_ONLY"]
        }
      }
    }
  }
}
