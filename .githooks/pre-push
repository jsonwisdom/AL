#!/usr/bin/env bash
set -e

bad="$(grep -RInE '"mode": *"SIMULATED"|sim_|sha256:simulated|SIMULATED' receipts || true)"
branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

if [[ -n "$bad" ]]; then
  echo "NO_FAKE_GREEN WARNING: simulated artifacts present"
  echo "$bad"

  while read local_ref local_sha remote_ref remote_sha; do
    if echo "$remote_ref" | grep -E 'real-genesis|production|v1.0' >/dev/null; then
      echo "BLOCKED: production/real tag with simulated artifacts"
      exit 1
    fi
  done

  if [[ "$branch" =~ ^(master|main)$ ]]; then
    echo "LOUD WARNING: pushing simulated artifacts to $branch"
  fi
fi
