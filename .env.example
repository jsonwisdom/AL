# TRACK_001 mainnet governance runtime

# Base Mainnet RPC endpoint (HTTPS)
BASE_RPC_URL=https://mainnet.base.org

# Operator private key (DO NOT COMMIT REAL VALUE)
# Used by track001_finalize.js for signing and submitting the attestation.
OPERATOR_PK=0xYOUR_OPERATOR_PRIVATE_KEY_HERE

# Base Mainnet chain ID (fixed)
CHAIN_ID=8453

# Base Mainnet EAS contract addresses
MAINNET_EAS_ADDRESS=0x4200000000000000000000000000000000000021
MAINNET_SCHEMA_REGISTRY=0x4200000000000000000000000000000000000020

# TRACK_001 mainnet schema UID (set after schema deployment)
MAINNET_SCHEMA_UID=0xYOUR_MAINNET_SCHEMA_UID_HERE

# ENS name used as the canonical routing surface
ENS_NAME=jaywisdom.eth

# Optional: ENS subname/Base identity routing surface
ENS_BASE_NAME=jaywisdom.base.eth

# Canonical schema paths
PREFLIGHT_SCHEMA_PATH=docs/attestations/TRACK_001_MAINNET_PREFLIGHT_SCHEMA.json
RECEIPT_SCHEMA_PATH=docs/attestations/TRACK_001_MAINNET_RECEIPT_SCHEMA.json

# Operator wallet expected by verifiers
OPERATOR_WALLET=0x992d94aA31dcD8fDb7d8E6885370ef8202AED399
