{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALMS Version Receipt",
  "type": "object",
  "required": [
    "event_type",
    "id",
    "old_version",
    "new_version",
    "old_state",
    "new_state",
    "artifact_path",
    "artifact_hash",
    "timestamp_utc"
  ],
  "properties": {
    "event_type": { "type": "string", "const": "alms_version_bump" },
    "id": { "type": "string" },
    "old_version": { "type": "string" },
    "new_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "old_state": { "type": "string" },
    "new_state": {
      "type": "string",
      "enum": ["DRAFT", "LOCKED", "REPLAY_REQUIRED", "REPLAY_PASSED", "BLOCKED", "DEPRECATED"]
    },
    "old_hash": { "type": ["string", "null"] },
    "artifact_path": { "type": "string" },
    "artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
