{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jsonwisdom://schemas/quadratic_edge_v0.1",
  "title": "Quadratic MindSet Edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edge_id",
    "source",
    "relation",
    "target",
    "state",
    "evidence"
  ],
  "properties": {
    "edge_id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "relation": {
      "enum": [
        "ENABLES",
        "DEPENDS_ON",
        "CONTRADICTS",
        "COMPLEMENTS",
        "SUPERSEDES",
        "REVERSES",
        "WITNESSES",
        "VERIFIES",
        "RECOMBINES",
        "SCALES"
      ]
    },
    "target": {"type": "string", "minLength": 1},
    "state": {
      "enum": [
        "PROPOSED",
        "TESTING",
        "VERIFIED",
        "FALSIFIED",
        "STALE",
        "ARCHIVED"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "test": {"type": ["string", "null"]},
    "receipt_ref": {"type": ["string", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "authority": {"const": false}
  }
}
