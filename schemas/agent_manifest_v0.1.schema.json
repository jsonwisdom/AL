{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.github.io/AL/schemas/agent_manifest_v0.1.schema.json",
  "title": "Agent Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "kind",
    "constitutional_basis",
    "targets_file",
    "allowed_domains",
    "allowed_url_schemes",
    "allowed_tags",
    "allowed_verdicts",
    "forbidden_fields",
    "runtime_limits",
    "output",
    "operational_state"
  ],
  "properties": {
    "agent_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "kind": { "enum": ["observer", "verifier", "detector", "tombstone"] },
    "constitutional_basis": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "targets_file": { "type": "string", "pattern": "^agents/.+/targets\\.yaml$" },
    "allowed_domains": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "allowed_url_schemes": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["https"] }
    },
    "allowed_tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "court_opinion",
          "court_docket",
          "agency_publication",
          "foia_page",
          "state_ag_record",
          "legislative_report",
          "budget_report",
          "public_manifest",
          "public_index"
        ]
      }
    },
    "allowed_verdicts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["FOUND", "NOT_FOUND", "VERSION_DRIFT", "CRAWLER_BLOCKED"]
      }
    },
    "forbidden_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "RISK_SCORE",
          "TRUST_SCORE",
          "CORRUPTION_SCORE",
          "SEVERITY",
          "SUSPICIOUS",
          "BLAME",
          "MOTIVE",
          "INTENT"
        ]
      }
    },
    "runtime_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_requests_per_run", "timeout_seconds", "network_required"],
      "properties": {
        "max_requests_per_run": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "network_required": { "type": "boolean" }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipts_dir", "circuit_id"],
      "properties": {
        "receipts_dir": { "const": "receipts" },
        "circuit_id": { "type": "string" }
      }
    },
    "operational_state": {
      "enum": ["ACTIVE_FOR_REVIEW", "ACTIVE", "DISABLED", "DEPRECATED"]
    }
  },
  "not": {
    "properties": {
      "kind": { "enum": ["adjudicator", "accuser", "risk_scorer", "trust_scorer", "moderator"] }
    },
    "required": ["kind"]
  }
}
