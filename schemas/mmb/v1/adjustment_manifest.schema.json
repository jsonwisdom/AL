{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mmb.adjustment_manifest.v1",
  "title": "MMB Adjustment Manifest V1",
  "type": "object",
  "required": [
    "schema_version",
    "namespace",
    "epoch_id",
    "fund_id",
    "line_items",
    "override_flag"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "mmb.adjustment_manifest.v1" },
    "namespace": { "const": "mmb/v1/adjustments" },
    "epoch_id": { "type": "string", "minLength": 1 },
    "fund_id": { "type": "string", "minLength": 1 },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "line_item_id",
          "epoch_id",
          "fund_id",
          "amount_delta_cents"
        ],
        "additionalProperties": false,
        "properties": {
          "line_item_id": { "type": "string", "minLength": 1 },
          "epoch_id": { "type": "string", "minLength": 1 },
          "fund_id": { "type": "string", "minLength": 1 },
          "amount_delta_cents": { "type": "integer" }
        }
      }
    },
    "override_flag": { "type": "boolean" },
    "override_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
