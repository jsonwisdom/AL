{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.example/schemas/JSONWISDOM_GLOBAL_EXECUTION_LEDGER_V0_1.schema.json",
  "title": "JSONWisdom Global Execution Ledger Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "record_type",
    "sequence",
    "repo",
    "ref",
    "commit_sha",
    "workflow_name",
    "workflow_run_id",
    "workflow_attempt",
    "started_at",
    "completed_at",
    "report",
    "counters",
    "runner",
    "receipt_ids",
    "source_hashes",
    "previous_entry_sha256",
    "entry_sha256",
    "authority",
    "no_fake_green"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "ledger_id": {"const": "JSONWISDOM_GLOBAL_EXECUTION_LEDGER"},
    "record_type": {"const": "WORKFLOW_EXECUTION_RECEIPT"},
    "sequence": {"type": "integer", "minimum": 1},
    "repo": {"type": "string", "minLength": 1},
    "ref": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "workflow_name": {"type": "string", "minLength": 1},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "workflow_attempt": {"type": "integer", "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "alms_version": {"type": ["string", "null"]},
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "verdict"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "verdict": {"enum": ["PASS", "FAIL", "MISSING", "INVALID"]}
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items_requested",
        "items_observed",
        "items_validated",
        "items_passed",
        "items_held",
        "items_conflicted",
        "items_rejected",
        "items_indeterminate"
      ],
      "properties": {
        "items_requested": {"type": "integer", "minimum": 0},
        "items_observed": {"type": "integer", "minimum": 0},
        "items_validated": {"type": "integer", "minimum": 0},
        "items_passed": {"type": "integer", "minimum": 0},
        "items_held": {"type": "integer", "minimum": 0},
        "items_conflicted": {"type": "integer", "minimum": 0},
        "items_rejected": {"type": "integer", "minimum": 0},
        "items_indeterminate": {"type": "integer", "minimum": 0}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "exit_code", "hard_gate_result"],
      "properties": {
        "name": {"const": "ci/replay_corpus_runner.py"},
        "exit_code": {"type": "integer"},
        "hard_gate_result": {"enum": ["PASS", "HOLD", "CONFLICT", "REJECT"]}
      }
    },
    "requested_replay_parameter": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit"],
          "properties": {
            "value": {"type": "integer", "minimum": 0},
            "unit": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "receipt_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"},
      "uniqueItems": true
    },
    "replay_hash": {"type": ["string", "null"], "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"},
    "receiptos_frame": {"type": ["string", "null"]},
    "ens_pointer": {"type": ["string", "null"]},
    "previous_entry_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "entry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {"const": false},
    "no_fake_green": {"const": true}
  }
}
