{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.org/schemas/saint_cloud_minutes_membrane.v0.2.schema.json",
  "title": "SaintCloudMinutesMembraneV02",
  "type": "object",
  "required": [
    "source_doc_id",
    "source_page",
    "source_line_number",
    "meeting_date",
    "text",
    "extraction_confidence",
    "membrane_state",
    "missing_fields"
  ],
  "properties": {
    "source_doc_id": {
      "type": "string"
    },
    "source_url": {
      "type": ["string", "null"]
    },
    "source_page": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "source_line_number": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "agenda_item_id": {
      "type": ["string", "null"]
    },
    "meeting_date": {
      "type": ["string", "null"]
    },
    "text": {
      "type": "string"
    },
    "watch_phrase_hits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolution_number": {
      "type": ["string", "null"]
    },
    "ordinance_number": {
      "type": ["string", "null"]
    },
    "motion_maker": {
      "type": ["string", "null"]
    },
    "second": {
      "type": ["string", "null"]
    },
    "vote_result": {
      "type": ["string", "null"]
    },
    "dollar_amounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effective_date": {
      "type": ["string", "null"]
    },
    "extraction_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "membrane_state": {
      "type": "string",
      "enum": [
        "CLEAN",
        "SOFTENED",
        "EVADED_PENDING_REVIEW",
        "CONTRADICTED",
        "PENDING_REVIEW"
      ]
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
