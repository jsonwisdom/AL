{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALMS Claim Bounding Test Ledger",
  "type": "object",
  "required": ["artifact", "ledger_id", "claim_scope", "claims"],
  "additionalProperties": false,
  "properties": {
    "artifact": { "const": "CLAIM_BOUNDING_TEST_LEDGER" },
    "ledger_id": { "type": "string" },
    "claim_scope": { "const": "ARTIFACT_TEXT_ONLY" },
    "artifact_ref": { "type": "string" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "capture_timestamp": { "type": "string" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "type", "status", "grounding"],
        "additionalProperties": false,
        "properties": {
          "claim_id": { "type": "string" },
          "statement": { "type": "string" },
          "type": { "enum": ["EXISTENCE", "FACTUAL", "INTERPRETATION"] },
          "status": { "enum": ["VERIFIED", "UNVERIFIED", "REJECTED"] },
          "grounding": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["node_ref", "evidence_sha256"],
              "additionalProperties": true,
              "properties": {
                "node_ref": { "type": "string" },
                "evidence_sha256": { "type": "string" },
                "capture_timestamp": { "type": "string" }
              }
            }
          },
          "expected_validator_result": { "enum": ["PASS", "REJECT", "DOWNGRADE"] }
        }
      }
    }
  }
}
