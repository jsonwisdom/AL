{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.github.io/AL/schemas/ATTESTATION_CANDIDATE.v1.schema.json",
  "title": "ALMS Attestation Candidate v1",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "candidate_id",
    "candidate_manifest_sha256",
    "claims_ledger_path",
    "claims_ledger_sha256",
    "subject_artifact",
    "subject_sha256",
    "commit",
    "onchain_status",
    "eas_uid",
    "tx_hash",
    "promotion",
    "gate_status",
    "claim"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "artifact": { "type": "string", "const": "ALMS_ATTESTATION_CANDIDATE" },
    "candidate_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "candidate_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "claims_ledger_path": { "type": "string", "minLength": 1 },
    "claims_ledger_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "subject_artifact": { "type": "string", "minLength": 1 },
    "subject_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "onchain_status": { "type": "string", "enum": ["NOT_ATTESTED", "PENDING", "ATTESTED", "FAILED"] },
    "eas_uid": { "type": ["string", "null"] },
    "tx_hash": { "type": ["string", "null"] },
    "promotion": { "type": "boolean" },
    "gate_status": { "type": "string", "enum": ["OPEN", "CLOSED"] },
    "claim": { "type": "string", "minLength": 1 },
    "created_at_utc": { "type": "string" },
    "repo": { "type": "string" },
    "branch": { "type": "string" },
    "stack_state": { "type": "string" },
    "write_run_0002": { "type": "string" },
    "custody_note": { "type": "string" }
  },
  "additionalProperties": false
}
