{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jsonwisdom/AL/schemas/karen11.schema.json",
  "title": "KAREN11 Runtime Validation Schema",
  "description": "Validates KAREN11 audit engine inputs and outputs. Authority is always false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim", "source", "output", "authority"],
  "properties": {
    "claim": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "authority": { "const": false }
  }
}
