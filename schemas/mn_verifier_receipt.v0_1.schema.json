{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/mn_verifier_receipt.v0_1.schema.json",
  "title": "MN Verifier Receipt v0.1",
  "description": "Minnesota verifier entry bound to a Court Verdict Binding receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "jurisdiction",
    "source_system",
    "data_hash",
    "court_binding"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v0.1"
    },
    "receipt_type": {
      "type": "string",
      "const": "MN_VERIFIER_DATA_ENTRY"
    },
    "jurisdiction": {
      "type": "string",
      "const": "MN_ST_CLOUD"
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "data_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "court_binding": {
      "type": "string",
      "description": "Reference to a COURT_VERDICT_BINDING receipt identifier."
    }
  }
}
