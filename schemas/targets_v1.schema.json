{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.github.io/AL/schemas/targets_v1.schema.json",
  "title": "Constitutional Target List v1",
  "description": "Defines the allowed structure for agent target lists. Closed-world: no unknown fields, no political labels, no silent semantic expansion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets"],
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "tags"],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "court_opinion",
                "court_docket",
                "agency_publication",
                "foia_page",
                "state_ag_record",
                "legislative_report",
                "budget_report",
                "public_manifest",
                "public_index"
              ]
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "added_by_pr": {
            "type": "string",
            "minLength": 1
          },
          "operational_state": {
            "enum": ["ACTIVE", "DEPRECATED"]
          },
          "deprecated": {
            "type": "boolean"
          },
          "deprecation_reason": {
            "type": "string",
            "minLength": 1
          },
          "deprecated_by_pr": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "deprecated": { "const": true }
              },
              "required": ["deprecated"]
            },
            "then": {
              "required": ["deprecation_reason", "deprecated_by_pr"]
            }
          }
        ]
      }
    }
  }
}
