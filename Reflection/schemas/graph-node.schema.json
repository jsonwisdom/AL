{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.dev/schemas/m2/graph-node.schema.json",
  "title": "Self Reflection Audit Station Graph Node",
  "description": "Canonical schema for graph nodes in the M2 Self Reflection Audit Station publication.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable node identifier"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "#/$defs/rfc3339"
    },
    "updated_at": {
      "$ref": "#/$defs/rfc3339"
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "properties": {
      "type": "object",
      "additionalProperties": true
    },
    "content_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time"
    }
  }
}
