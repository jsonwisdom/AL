{
  "version": "0.2",
  "doctrine": {
    "public_claim_mode": "ANOMALY_LEADS_ONLY",
    "no_fraud_verdict_without_source_and_human_review": true,
    "public_content_claim_default": "BLOCKED_PENDING_HUMAN_REVIEW",
    "human_review_required_default": true,
    "no_fake_green": true,
    "rules_patch_mode": "HUMAN_REVIEW_AUTHORIZED",
    "rules_patch_source": "projects/mn-fiscal-replay/boss_bre/latest_review_decision_record.json"
  },
  "rules": [
    {
      "id": "BBRISK_MEDICAID_CMS_WITHHOLDING",
      "severity": "HIGH",
      "label": "MEDICAID_CMS_WITHHOLDING_OR_DISALLOWANCE_RISK",
      "pattern": "Medicaid|CMS|federal matching funds|withhold|withheld|withholding|deferral|disallowance|denied|prepayment review|high-risk Medicaid"
    },
    {
      "id": "BBRISK_FRAUD_RISK_LANGUAGE",
      "severity": "HIGH",
      "label": "FRAUD_RISK_LANGUAGE_REQUIRES_REVIEW",
      "pattern": "fraud|fraudulent|suspicious|investigation|audit finding|material weakness|significant deficiency"
    },
    {
      "id": "BBRISK_DEFICIT_SHORTFALL_VARIANCE",
      "severity": "HIGH",
      "label": "DEFICIT_SHORTFALL_OR_UNEXPLAINED_VARIANCE",
      "pattern": "deficit|shortfall|structural imbalance|unexplained variance|material variance|negative balance|budget gap"
    },
    {
      "id": "BBRISK_LARGE_DOLLAR_AMOUNT",
      "severity": "MEDIUM",
      "label": "LARGE_DOLLAR_AMOUNT",
      "pattern": "\\$[0-9][0-9,]*(\\.[0-9]+)?[ ]*(million|billion)|[0-9]+(\\.[0-9]+)?[ ]*(million|billion)"
    },
    {
      "id": "BBRISK_PROGRAM_REDUCTION_OR_RESERVE_DRAW",
      "severity": "MEDIUM",
      "label": "PROGRAM_REDUCTION_OR_RESERVE_DRAW",
      "pattern": "reduction|decrease|decline|lower than|down compared|program reduction|reserve draw|drawdown|debt service|forecast revision"
    },
    {
      "id": "BBRISK_FORECAST_VOLATILITY",
      "severity": "LOW",
      "label": "FORECAST_VOLATILITY_LANGUAGE",
      "pattern": "volatile|uncertain|risk|planning estimate|negative shocks|baseline projection"
    },
    {
      "id": "BBRISK_MISSING_PAYLOAD",
      "severity": "HIGH",
      "label": "EVIDENCE_CHAIN_BLOCKED",
      "pattern": "FORENSIC_PAYLOAD_MISSING|FETCH_BLOCKED|SOURCE_URL_MISSING|EXTRACT_BLOCKED"
    }
  ],
  "noise_suppression_guidance": {
    "mode": "REVIEW_ONLY_NOT_DETECTOR_ENFORCED",
    "patterns": [
      "page header",
      "table of contents",
      "contents",
      "appendix",
      "source:",
      "accessed",
      "OCR artifact",
      "layout artifact"
    ]
  },
  "public_language": {
    "allowed": [
      "audit lead",
      "anomaly lead",
      "risk signal",
      "requires human review",
      "source-backed fiscal inconsistency"
    ],
    "blocked_without_review": [
      "fraud proven",
      "criminal finding",
      "confirmed corruption",
      "illegal payment"
    ]
  }
}
