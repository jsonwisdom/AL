{
  "artifact": "COMPACT_SCHEMA_V1",
  "layer": "FEDERATION",
  "purpose": "Canonical schema for replay-verifiable cross-state compacts bound to attested governance epochs.",
  "last_verified": "2026-05-06",
  "verifier": "jsonwisdom",
  "compact_shape": {
    "compact_id": "compact_identifier",
    "participants": [
      {
        "state": "state_abbreviation",
