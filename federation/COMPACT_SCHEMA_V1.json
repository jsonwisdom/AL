        "epoch_root_sha256": "attested_epoch_root"
      }
    ],
    "subject_matter": "compact_subject_domain",
    "constraints": {
      "baseline_mutation": "forbidden",
      "state_sovereignty": "preserved",
      "federal_preemption": "explicitly_scoped"
