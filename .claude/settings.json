{
  "status": "ACTIVE",
  "purpose": "Limit AI-assisted workflows to safe, inspectable operations.",
  "permissions": {
    "deny": [
      "rm -rf *",
      "git push --force",
      "git reset --hard",
      "npm publish",
      "gh repo delete"
    ],
    "allow": [
      "git status --short",
      "git diff",
      "git log -1",
      "git rev-parse HEAD",
      "find .claude -maxdepth 3 -type f | sort"
    ]
  }
}
