{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/gray-baby/test-receipt.schema.json",
  "title": "Gray Baby Test Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "framework_cycle_reference", "test_id", "receipt_type", "schema_version", "target", "event", "evidence", "assessment", "correction", "authority"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "framework_cycle_reference": {"type": "string", "minLength": 1},
    "test_id": {"type": "string", "pattern": "^C(0[1-9]|10)$"},
    "receipt_type": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "version", "environment_hash"],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "environment_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "action", "scope", "status", "observed_at"],
      "properties": {
        "actor": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointers", "input_hash", "output_hash"],
      "properties": {
        "pointers": {"type": "array", "items": {"type": "string"}},
        "input_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "output_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "previous_receipt_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_state", "observed_state", "result", "contradictions"],
      "properties": {
        "expected_state": {"type": "string", "minLength": 1},
        "observed_state": {"type": "string", "minLength": 1},
        "result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_EXECUTED"]},
        "contradictions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "next_action", "review_due"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "next_action": {"type": "string", "minLength": 1},
        "review_due": {"type": "string", "format": "date-time"}
      }
    },
    "authority": {"const": false}
  }
}
