{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALMS Replay Registry",
  "type": "object",
  "required": ["version", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "receipt_commit",
          "receipt_path",
          "manifest_commit",
          "manifest_path",
          "root",
          "leaf_count",
          "status",
          "timestamp",
          "scope",
          "trust_layer"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "type": { "type": "string", "const": "ALMS_CENSUS_REPLAY_OK" },
          "receipt_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "receipt_path": { "type": "string", "pattern": "^_truth/replay/.+\\.html$" },
          "manifest_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "manifest_path": { "type": "string", "const": "_truth/merkle/manifest.json" },
          "root": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "leaf_count": { "type": "integer", "minimum": 1 },
          "status": { "type": "string", "const": "GITHUB_DIRECT_CONFIRMED" },
          "timestamp": { "type": "string", "format": "date-time" },
          "scope": { "type": "string" },
          "trust_layer": { "type": "string", "const": "github_direct_only" }
        }
      }
    }
  }
}
