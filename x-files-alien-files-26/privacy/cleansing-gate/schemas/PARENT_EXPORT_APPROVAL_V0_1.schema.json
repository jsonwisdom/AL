{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParentExportApproval",
  "description": "Schema for verifying parent-authorized export manifests. Runtime validation required: expires_at must be later than issued_at with a maximum five-minute validity window.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "asset_id",
    "parent_signature",
    "session_id",
    "nonce",
    "issued_at",
    "expires_at",
    "pipeline_version",
    "input_sha256",
    "output_sha256",
    "preview_sha256",
    "export_target",
    "normalized_filename",
    "stego_policy",
    "signing_key_id",
    "signature_algorithm",
    "cleansing_required"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "pipeline_version": {
      "type": "string",
      "const": "CLEANSING_GATE_V0_1"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "preview_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "export_target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "local-only"
            },
            "destination": {
              "type": "null"
            }
          },
          "required": [
            "mode",
            "destination"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "explicit-destination"
            },
            "destination": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "destination"
          ],
          "additionalProperties": false
        }
      ]
    },
    "normalized_filename": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z_[a-f0-9]{16}\\.[a-z0-9]{2,5}$"
    },
    "stego_policy": {
      "type": "string",
      "enum": [
        "REJECT_IF_DETECTED_OR_UNSUPPORTED"
      ]
    },
    "signing_key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature_algorithm": {
      "type": "string",
      "const": "Ed25519"
    },
    "cleansing_required": {
      "type": "boolean",
      "const": true
    }
  }
}
