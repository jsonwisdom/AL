{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jsonwisdom/AL/active_lanes.schema.json",
  "title": "Active Lanes Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lanes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "status",
          "status_source",
          "receipt_type",
          "receipt_ptr",
          "replay_verdict",
          "delta_h"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "GREEN",
              "REPORTED_UNVERIFIED",
              "REPORTED",
              "INFERRED",
              "BLOCKED"
            ]
          },
          "status_source": {
            "type": "string",
            "enum": [
              "VERIFIED_RECEIPT",
              "SCREENSHOT_RECEIPT_GREEN",
              "REPORTED_RECEIPT",
              "INFERRED"
            ]
          },
          "receipt_type": {
            "type": "string",
            "enum": [
              "API",
              "SCREENSHOT",
              "HYBRID",
              "NONE"
            ]
          },
          "receipt_ptr": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "replay_verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "PENDING",
              "UNAVAILABLE",
              "FAIL"
            ]
          },
          "delta_h": {
            "type": "integer",
            "minimum": 0
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "GREEN"
                }
              }
            },
            "then": {
              "properties": {
                "status_source": {
                  "const": "VERIFIED_RECEIPT"
                },
                "receipt_type": {
                  "enum": [
                    "API",
                    "HYBRID"
                  ]
                },
                "receipt_ptr": {
                  "type": "string",
                  "minLength": 1
                },
                "replay_verdict": {
                  "const": "PASS"
                },
                "delta_h": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status_source": {
                  "const": "SCREENSHOT_RECEIPT_GREEN"
                }
              }
            },
            "then": {
              "properties": {
                "receipt_type": {
                  "const": "SCREENSHOT"
                },
                "receipt_ptr": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "replay_verdict": {
                  "enum": [
                    "PENDING",
                    "PASS"
                  ]
                },
                "delta_h": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "receipt_type": {
                  "const": "NONE"
                }
              }
            },
            "then": {
              "properties": {
                "receipt_ptr": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    }
  }
}
