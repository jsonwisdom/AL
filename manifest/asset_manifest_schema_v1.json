{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jsonwisdom/AL/manifest/asset_manifest_schema_v1.json",
  "title": "ASSET_MANIFEST_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "asset_id",
    "asset_hash",
    "hash_algorithm",
    "branch_id",
    "issuer_key_id",
    "issued_at_utc",
    "nonce",
    "claims",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "asset_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hash_algorithm": { "const": "SHA-256" },
    "branch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issuer_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nonce": {
      "type": "string",
      "minLength": 16,
      "maxLength": 256
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_type", "claim_value"],
        "properties": {
          "claim_type": {
            "type": "string",
            "enum": [
              "CUSTODY_ASSERTION",
              "INTEGRITY_ASSERTION",
              "REBINDING_INTENT",
              "REVOCATION_INTENT",
              "CLASSIFICATION_ASSERTION"
            ]
          },
          "claim_value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "linked_verifier_receipt": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "minLength": 1
    }
  }
}
