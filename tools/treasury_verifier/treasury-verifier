#!/usr/bin/env python3
import argparse, json, sys, time, hashlib, base64, pathlib, datetime, subprocess

BAD_TAG_WORDS=("real-genesis","production","v1.0")
SIM_MARKERS=("SIMULATED","sim_","simulated_","sha256:simulated")

def load(p): return json.load(open(p,"r",encoding="utf-8"))
def canon(o): return json.dumps(o,sort_keys=True,separators=(",",":")).encode()
def sha(o): return "sha256:"+hashlib.sha256(canon(o)).hexdigest()
def is_sim(v):
    if isinstance(v,str): return any(m in v for m in SIM_MARKERS)
    if isinstance(v,dict): return any(is_sim(x) for x in v.values())
    if isinstance(v,list): return any(is_sim(x) for x in v)
    return False
def ts_check(r,drift):
    t=r.get("source_fetched_at_utc") or r.get("last_verified")
    if not t: return False,"missing timestamp"
    try:
        dt=datetime.datetime.fromisoformat(t.replace("Z","+00:00")).timestamp()
        d=abs(time.time()-dt)
        return d<=drift,f"timestamp drift {int(d)}s > {drift}s"
    except Exception as e: return False,f"bad timestamp: {e}"
def sign_result(payload):
    key=pathlib.Path(".treasury-verifier-signing-key").read_text().strip() if pathlib.Path(".treasury-verifier-signing-key").exists() else ""
    sig=hashlib.sha256((key+json.dumps(payload,sort_keys=True)).encode()).hexdigest() if key else None
    return sig
def verify_file(path,mode,drift):
    r=load(path); warnings=[]; errors=[]
    sim=is_sim(r) or r.get("mode")=="SIMULATED" or r.get("ledger_status","").startswith("SIMULATED")
    ok,msg=ts_check(r,drift)
    if not ok: (errors if mode=="strict" else warnings).append(msg)
    if sim:
        (errors if mode=="strict" else warnings).append("simulated artifact detected")
    if r.get("receipt_hash") and r.get("normalized_receipt_hash") and r["receipt_hash"]!=r["normalized_receipt_hash"]:
        errors.append("receipt_hash mismatch")
    status="PASS" if not errors else "FAIL"
    out={"verifier":"treasury-verifier/v0.2","mode":mode,"path":str(path),"status":status,"warnings":warnings,"errors":errors,"verified_at":datetime.datetime.now(datetime.timezone.utc).isoformat()}
    if status=="PASS": out["detached_result_signature"]=sign_result(out)
    return out
def batch(root,mode,drift):
    files=list(pathlib.Path(root).rglob("*.json"))
    return {"batch_root":root,"count":len(files),"results":[verify_file(f,mode,drift) for f in files]}
def main():
    p=argparse.ArgumentParser("treasury-verifier")
    sub=p.add_subparsers(dest="cmd",required=True)
    v=sub.add_parser("verify"); v.add_argument("file"); v.add_argument("--mode",choices=["strict","audit"],default="strict"); v.add_argument("--drift-seconds",type=int,default=300)
    b=sub.add_parser("batch-verify"); b.add_argument("root",default="receipts",nargs="?"); b.add_argument("--mode",choices=["strict","audit"],default="strict"); b.add_argument("--drift-seconds",type=int,default=300)
    a=p.parse_args()
    out=verify_file(a.file,a.mode,a.drift_seconds) if a.cmd=="verify" else batch(a.root,a.mode,a.drift_seconds)
    print(json.dumps(out,indent=2,sort_keys=True))
    print("\nSUMMARY:", out.get("status","BATCH"), "NO_FAKE_GREEN preserved")
    sys.exit(0 if (out.get("status")!="FAIL") else 1)
if __name__=="__main__": main()
