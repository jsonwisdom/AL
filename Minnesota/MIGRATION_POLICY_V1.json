{
  "policy_id": "MN_CANONICAL_FOLDER_MIGRATION_V1",
  "version": "1.1.0",
  "destination_root": "Minnesota",
  "default_mode": "dry-run",
  "apply_confirmation": "MOVE_MINNESOTA_WITH_RECEIPTS",
  "safe_prefixes": [
    "projects/mn-fiscal-replay",
    "_truth/mn",
    "_truth/mn_governor",
    "sources/mn",
    "fixtures/mn",
    "_truth/registry/claim_0001"
  ],
  "safe_globs": [
    "data/mn_*.json",
    "_sources/MN_*/*",
    "_sources/MN_*/**/*",
    "_truth/receipts/MN_*.json",
    "_truth/receipts/mn_*.json",
    "scripts/boss_bre_*",
    "scripts/mn*.sh",
    "scripts/mn*.py",
    "scripts/saint_cloud*",
    "scripts/fetch_st_cloud*",
    "docs/**/Minnesota*",
    "docs/**/minnesota*",
    "docs/**/MN_*"
  ],
  "exclude_prefixes": [
    ".git",
    "Minnesota",
    "node_modules",
    ".venv",
    "venv"
  ],
  "immutable_destination_prefixes": [
    "Minnesota/_truth",
    "Minnesota/_sources",
    "Minnesota/sources",
    "Minnesota/fixtures",
    "Minnesota/projects/mn-fiscal-replay/boss_bre/runs",
    "Minnesota/projects/mn-fiscal-replay/live_fetch"
  ],
  "rewrite_globs": [
    ".github/workflows/*.yml",
    ".github/workflows/*.yaml",
    "README.md",
    "*.md",
    "scripts/*.sh",
    "scripts/*.py",
    "Minnesota/scripts/*.sh",
    "Minnesota/scripts/*.py",
    "Minnesota/projects/mn-fiscal-replay/*.md",
    "Minnesota/projects/mn-fiscal-replay/*.json",
    "Minnesota/projects/mn-fiscal-replay/*.sh",
    "Minnesota/projects/mn-fiscal-replay/*.py",
    "Minnesota/projects/mn-fiscal-replay/boss_bre/*.md",
    "Minnesota/projects/mn-fiscal-replay/boss_bre/*.json",
    "Minnesota/projects/mn-fiscal-replay/boss_bre/*.sh",
    "Minnesota/projects/mn-fiscal-replay/boss_bre/*.py"
  ],
  "review_path_markers": [
    "minnesota",
    "mn_",
    "mn-",
    "st_cloud",
    "saint_cloud",
    "stearns",
    "boss_bre",
    "governor_walz",
    "mn_governor"
  ],
  "review_content_markers": [
    "Minnesota",
    "State of Minnesota",
    "St. Cloud",
    "Saint Cloud",
    "Stearns County",
    "Minnesota Governor",
    "MN Fiscal Replay",
    "Boss Bre"
  ],
  "text_extensions": [
    ".md",
    ".txt",
    ".json",
    ".jsonl",
    ".yml",
    ".yaml",
    ".py",
    ".sh",
    ".html",
    ".css",
    ".js",
    ".ts",
    ".tsx",
    ".csv",
    ".toml",
    ".ini"
  ],
  "max_content_scan_bytes": 2097152,
  "governance": {
    "no_fake_green": true,
    "human_review_required": true,
    "public_promotion_authorized": false,
    "direct_default_branch_mutation": false,
    "hash_algorithm": "sha256",
    "preserve_source_bytes": true,
    "fail_on_destination_conflict": true,
    "silence_is_not_consent": true,
    "minority_report_preserved": true,
    "womens_opinions_preserved": true,
    "nonviolent_only": true
  }
}
