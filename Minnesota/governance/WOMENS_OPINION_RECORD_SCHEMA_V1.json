{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jsonwisdom.example/schemas/minnesota/WOMENS_OPINION_RECORD_SCHEMA_V1.json",
  "title": "Women's Opinion Record Schema v1",
  "description": "Preserves authored opinions, evidence, dissent, alternatives, and organizational responses without reducing participation to a vote or silence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "process_id",
    "participant",
    "opinion",
    "publication",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "WOMENS_OPINION_RECORD_SCHEMA_V1"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "process_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_ref", "role", "self_identified_as_woman"],
      "properties": {
        "participant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "display_name": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "self_identified_as_woman": {
          "type": ["boolean", "null"],
          "description": "Voluntary self-identification. Null means not stated or intentionally withheld."
        },
        "representation_claim": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "invited": {"type": ["boolean", "null"]},
        "access_provided": {"type": ["boolean", "null"]},
        "barriers": {
          "type": "array",
          "items": {"type": "string", "maxLength": 1000},
          "maxItems": 50
        },
        "participation_method": {
          "type": ["string", "null"],
          "maxLength": 200
        }
      }
    },
    "opinion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "authored_statement", "concerns", "alternatives", "conditions", "evidence_refs"],
      "properties": {
        "position": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SUPPORTS",
              "OPPOSES",
              "CONDITIONAL_SUPPORT",
              "PROPOSES_ALTERNATIVE",
              "REQUESTS_MORE_EVIDENCE",
              "RAISES_RISK",
              "DISSENTS",
              "ABSTAINS_WITH_REASON",
              "WITHHOLDS_POSITION",
              "UNRESOLVED"
            ]
          }
        },
        "authored_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        },
        "concerns": {
          "type": "array",
          "items": {"type": "string", "maxLength": 5000},
          "maxItems": 100
        },
        "alternatives": {
          "type": "array",
          "items": {"type": "string", "maxLength": 5000},
          "maxItems": 100
        },
        "conditions": {
          "type": "array",
          "items": {"type": "string", "maxLength": 5000},
          "maxItems": 100
        },
        "questions": {
          "type": "array",
          "items": {"type": "string", "maxLength": 5000},
          "maxItems": 100
        },
        "requested_changes": {
          "type": "array",
          "items": {"type": "string", "maxLength": 5000},
          "maxItems": 100
        },
        "evidence_refs": {
          "type": "array",
          "items": {"type": "string", "maxLength": 1000},
          "maxItems": 200
        }
      }
    },
    "vote": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "vote_value": {
          "enum": ["YES", "NO", "ABSTAIN", "PRESENT", "NOT_CAST", "NOT_APPLICABLE"]
        },
        "vote_time": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "vote_note": {
          "type": ["string", "null"],
          "maxLength": 5000
        }
      },
      "required": ["vote_value"]
    },
    "organizational_response": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "ADOPTED",
            "PARTIALLY_ADOPTED",
            "NOT_ADOPTED_WITH_REASON",
            "DEFERRED_WITH_TRIGGER",
            "REQUIRES_MORE_EVIDENCE",
            "OUT_OF_SCOPE_WITH_REASON",
            "UNANSWERED"
          ]
        },
        "response_text": {
          "type": "string",
          "maxLength": 50000
        },
        "responded_by": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "response_time": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "changes_caused": {
          "type": "array",
          "items": {"type": "string", "maxLength": 5000},
          "maxItems": 100
        },
        "unresolved_items": {
          "type": "array",
          "items": {"type": "string", "maxLength": 5000},
          "maxItems": 100
        }
      },
      "required": ["disposition", "response_text", "changes_caused", "unresolved_items"]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consent_status", "redaction_required"],
      "properties": {
        "consent_status": {
          "enum": [
            "CONSENTED",
            "CONSENT_WITH_LIMITS",
            "NOT_CONSENTED",
            "LAWFUL_PUBLIC_RECORD_BASIS",
            "UNDETERMINED"
          ]
        },
        "redaction_required": {"type": "boolean"},
        "publication_limits": {
          "type": "array",
          "items": {"type": "string", "maxLength": 1000},
          "maxItems": 50
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opinion_creates_execution_authority", "decision_authority_ref"],
      "properties": {
        "opinion_creates_execution_authority": {
          "const": false
        },
        "decision_authority_ref": {
          "type": ["string", "null"],
          "maxLength": 500
        }
      }
    },
    "integrity": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "canonicalization": {
          "type": ["string", "null"],
          "maxLength": 200
        },
        "sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "maxLength": 1000},
          "maxItems": 200
        }
      }
    }
  }
}
