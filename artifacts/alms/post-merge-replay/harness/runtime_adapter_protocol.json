{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goblin.court/harness/runtime_adapter_protocol.json",
  "title": "ALMS Runtime Adapter Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapter_version", "bedrock_sha", "vectors"],
  "properties": {
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "bedrock_sha": {
      "type": "string",
      "const": "59448d850d355854956cb5834ebef17f7f14c7dc"
    },
    "vectors": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_id",
          "name",
          "injected",
          "observed_state",
          "expected_state",
          "events",
          "counter_before",
          "counter_after"
        ],
        "properties": {
          "failure_id": {
            "type": "string",
            "pattern": "^F00[1-6]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "injected": {
            "const": true
          },
          "observed_state": {
            "type": "string",
            "minLength": 1
          },
          "expected_state": {
            "type": "string",
            "minLength": 1
          },
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "detail"],
              "properties": {
                "kind": {"type": "string", "minLength": 1},
                "detail": {"type": "string", "minLength": 1}
              }
            }
          },
          "counter_before": {
            "type": "integer",
            "minimum": 0
          },
          "counter_after": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
