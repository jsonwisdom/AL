{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goblin.court/schemas/CRO.payload.schema.json",
  "title": "Constitutional Replay Payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cro_id",
    "replay_root",
    "bedrock_sha",
    "replay_started_at",
    "replay_completed_at",
    "replay_verdict",
    "failure_results",
    "monotonic_counters"
  ],
  "properties": {
    "cro_id": {"type": "string", "minLength": 1},
    "replay_root": {
      "type": "string",
      "const": "59448d850d355854956cb5834ebef17f7f14c7dc"
    },
    "bedrock_sha": {
      "type": "string",
      "const": "59448d850d355854956cb5834ebef17f7f14c7dc"
    },
    "replay_started_at": {"type": "string", "format": "date-time"},
    "replay_completed_at": {"type": "string", "format": "date-time"},
    "replay_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {"type": "string", "enum": ["GREEN", "RED"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "failure_results": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "failure_id",
          "vector",
          "injected",
          "observed_state",
          "expected_state",
          "passed",
          "events",
          "counters_before",
          "counters_after",
          "recovery_action",
          "blast_radius"
        ],
        "properties": {
          "failure_id": {"type": "string", "pattern": "^F[0-9]{3}$"},
          "vector": {"type": "string", "minLength": 1},
          "injected": {"const": true},
          "observed_state": {"type": "string", "minLength": 1},
          "expected_state": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "events": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["sequence", "event", "observed_state", "evidence_sha256"],
              "properties": {
                "sequence": {"type": "integer", "minimum": 0},
                "event": {"type": "string", "minLength": 1},
                "observed_state": {"type": "string", "minLength": 1},
                "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "counters_before": {"type": "integer", "minimum": 0},
          "counters_after": {"type": "integer", "minimum": 0},
          "recovery_action": {"type": "string", "minLength": 1},
          "blast_radius": {"type": "string", "minLength": 1}
        }
      }
    },
    "monotonic_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "monotonic"],
      "properties": {
        "before": {"type": "integer", "minimum": 0},
        "after": {"type": "integer", "minimum": 0},
        "monotonic": {"type": "boolean"}
      }
    }
  }
}
